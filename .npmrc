# expo-router pulls in react-dom, whose peer range asks for a newer react than
# the one Expo SDK 57 pins for this project. `npx expo install --check` reports
# the tree as correct, so the conflict is npm's strictness about a transitive
# web dependency this app never loads — it ships to iOS and Android only.
#
# Set here rather than passed as a flag so `npm ci` in CI resolves exactly as a
# local install does. Without it CI fails at install with ERESOLVE.
legacy-peer-deps=true
